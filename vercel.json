{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "api/**",
          "JLIB_BE/**",
          "requirements.txt"
        ]
      }
    },
    {
      "src": "JLIB_FE/jlib_ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/books(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/users(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/JLIB_FE/jlib_ui/$1"
    }
  ]
}
